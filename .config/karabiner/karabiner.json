{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Ghostty: cmd+v で画像は ctrl+v、テキストは ctrl+cmd+v として貼り付け",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "v",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.local/bin/ghostty-paste.sh"
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            "fn_function_keys": [
                {
                    "from": { "key_code": "f6" },
                    "to": [ { "key_code": "f6" } ]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": {
                "country_code": 0,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}
