# Ghostty config
# 配置場所: ~/.config/ghostty/config
# 全オプション: ghostty +show-config --default --docs / https://ghostty.org/docs/config
# 再読込: cmd+shift+,

# shift+enter で改行を送る (Claude Code / Codex 等の TUI 向け)
keybind = shift+enter=text:\n

scrollback-limit = 100000

shell-integration = detect
shell-integration-features = cursor,sudo,title

font-family = Monaco
font-family = Ricty for Powerline
font-size = 16
