#!/usr/bin/env bash
# studio-share: ローカル (MacBook) のファイル / クリップボードの中身を mac-studio の ~/inbox に送り、
#               リモート側の絶対パスを表示してローカルのクリップボードにも入れる。
#
#   studio-share foo.png bar/            ファイル・ディレクトリを送る
#   studio-share                         引数なし = クリップボードを送る
#                                        (Finder でコピーしたファイル / 画像 / テキスト を自動判別)
#   studio-share -a claude foo.png       送った後、studio 上の herdr エージェント "claude" に
#                                        パスをプロンプトとして投げる (herdr machine add studio が必要)
#   studio-share -m "この画面の崩れを直して" -a claude foo.png
#
# 送り先: studio:~/inbox/share/YYYY-MM-DD/HHMMSS-xxxx/<basename>   (1 回の送信ごとに一意なディレクトリ)
#         クリップボード由来は ~/inbox/clip/YYYY-MM-DD/HHMMSS-xxxx/
# 受信側の mtime は「届いた時刻」になる (-t を付けない) ので、ls -t と 30 日掃除は受信時刻基準で動く。
# 環境変数: STUDIO_HOST (ssh の Host 名, 既定 studio) / STUDIO_INBOX (リモート ~ 相対, 既定 inbox)
set -euo pipefail

HOST="${STUDIO_HOST:-studio}"
INBOX="${STUDIO_INBOX:-inbox}"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=3)
AGENT=""
MSG=""
DRY=0
NO_PBCOPY=0

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
log() { printf '%s\n' "$*" >&2; }
die() { log "studio-share: $*"; exit 1; }

while getopts ":a:m:nPh" opt; do
  case "$opt" in
    a) AGENT="$OPTARG" ;;
    m) MSG="$OPTARG" ;;
    n) DRY=1 ;;
    P) NO_PBCOPY=1 ;;
    h) usage 0 ;;
    *) usage 1 ;;
  esac
done
shift $((OPTIND - 1))

# リモート側 shell に埋め込むので、inbox は安全な相対パスに限定する
case "$INBOX" in
  ''|/*|*..*|*[!A-Za-z0-9._/-]*) die "STUDIO_INBOX が不正です: $INBOX" ;;
esac

TMPDIR_LOCAL="$(mktemp -d "${TMPDIR:-/tmp}/studio-share.XXXXXX")"
trap 'rm -rf "$TMPDIR_LOCAL"' EXIT

# --- クリップボードの中身をファイル化 (結果は $1 に NUL 区切りで書く) ------------------
clipboard_sources() {
  local out="$1" info ts
  info="$(osascript -e 'clipboard info' 2>/dev/null || true)"
  ts="$(date +%H%M%S)"

  # 1) Finder でコピーしたファイル (file URL) → そのパスをそのまま送る
  if [[ "$info" == *"«class furl»"* ]]; then
    osascript -l JavaScript -e '
      ObjC.import("AppKit");
      const pb = $.NSPasteboard.generalPasteboard;
      const opts = $.NSDictionary.dictionaryWithObjectForKey(
        $.NSNumber.numberWithBool(true), $.NSPasteboardURLReadingFileURLsOnlyKey);
      const urls = pb.readObjectsForClassesOptions($.NSArray.arrayWithObject($.NSURL), opts);
      const out = [];
      for (let i = 0; i < urls.count; i++) out.push(ObjC.unwrap(urls.objectAtIndex(i).path));
      out.join("\u0000");
    ' | tr -d '\n' > "$out"
    return
  fi

  # 2) 画像 (スクショ / ブラウザからコピーした画像) → PNG に書き出す
  #    ※ herdr --remote 上なら ctrl+v で herdr 自身が画像を転送するので、通常はそちらで足りる
  if [[ "$info" == *"PNGf"* || "$info" == *"TIFF"* ]]; then
    local png="$TMPDIR_LOCAL/clip-$ts.png"
    if command -v pngpaste >/dev/null 2>&1; then
      pngpaste "$png"
    else
      osascript -l JavaScript -e '
        function run(argv) {
          ObjC.import("AppKit");
          const path = $(argv[0]);
          const pb = $.NSPasteboard.generalPasteboard;
          const img = $.NSImage.alloc.initWithPasteboard(pb);
          if (img.isNil()) throw new Error("no image on clipboard");
          const rep = $.NSBitmapImageRep.imageRepWithData(img.TIFFRepresentation);
          const png = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $.NSDictionary.dictionary);
          if (!png.writeToFileAtomically(path, true)) throw new Error("write failed");
        }
      ' "$png" >/dev/null
    fi
    printf '%s' "$png" > "$out"
    return
  fi

  # 3) テキスト: 既存ファイルのパスが 1 行だけ入っていればそのファイル、それ以外は .txt として送る
  local txt="$TMPDIR_LOCAL/clip-$ts.txt"
  pbpaste > "$txt" 2>/dev/null || true
  [[ -s "$txt" ]] || die "クリップボードが空です"
  local text candidate
  text="$(cat "$txt")"
  candidate="${text/#\~/$HOME}"
  if [[ "$text" != *$'\n'* && -e "$candidate" ]]; then
    printf '%s' "$candidate" > "$out"
    return
  fi
  printf '%s' "$txt" > "$out"
}

# --- 送るものを決める (絶対パス化) ----------------------------------------------
abspath() {
  if [[ -d "$1" ]]; then (cd "$1" && pwd -P)
  else (cd "$(dirname "$1")" && printf '%s/%s' "$(pwd -P)" "$(basename "$1")")
  fi
}

SRCS=()
SUBDIR="share"
if [[ $# -gt 0 ]]; then
  for p in "$@"; do
    [[ -e "$p" ]] || die "見つかりません: $p"
    SRCS+=("$(abspath "${p%/}")")
  done
else
  SUBDIR="clip"
  LIST="$TMPDIR_LOCAL/sources"
  clipboard_sources "$LIST"       # 失敗は set -e で止まる (プロセス置換だと拾えないのでファイル経由)
  while IFS= read -r -d '' p || [[ -n "$p" ]]; do
    [[ -n "$p" ]] && SRCS+=("$(abspath "$p")")
  done < "$LIST"
  [[ ${#SRCS[@]} -gt 0 ]] || die "クリップボードから送れるものが見つかりません"
fi

# 同じバッチ内の basename 重複は上書きになるので拒否
dup="$(printf '%s\n' "${SRCS[@]##*/}" | sort | uniq -d)"; dup="${dup%%$'\n'*}"
[[ -z "$dup" ]] || die "同名のファイルが複数あります ($dup)。分けて送ってください"

DAY="$(date +%F)"
BATCH="$(date +%H%M%S)-$(printf '%04x' "$RANDOM")"
RDIR="$INBOX/$SUBDIR/$DAY/$BATCH"     # リモート ~ 相対 (安全な文字しか含まない)

if [[ $DRY -eq 1 ]]; then
  log "[dry-run] -> $HOST:~/$RDIR/"
  printf '  %s\n' "${SRCS[@]}" >&2
  exit 0
fi

# --- 送信 ----------------------------------------------------------------------
RHOME="$(ssh "${SSH_OPTS[@]}" "$HOST" "umask 077 && mkdir -p ~/'$RDIR' && chmod 700 ~/'$INBOX' && printf %s \"\$HOME\"")" \
  || die "$HOST に ssh できません (Tailscale 接続と ssh 鍵を確認)"

# -t を付けず受信時刻を mtime にする。-e で ssh のタイムアウトも転送本体に効かせる
rsync -rlp --timeout=60 -e "ssh ${SSH_OPTS[*]}" -- "${SRCS[@]}" "$HOST:$RDIR/" || die "rsync に失敗しました"

# --- リモートの絶対パスを出力 ---------------------------------------------------
PATHS=""
for s in "${SRCS[@]}"; do
  PATHS+="$RHOME/$RDIR/$(basename "$s")"$'\n'
done
PATHS="${PATHS%$'\n'}"
printf '%s\n' "$PATHS"
if [[ $NO_PBCOPY -eq 0 ]]; then
  printf '%s' "$PATHS" | pbcopy
  log "(リモートのパスをクリップボードにコピーしました。Claude / Codex のプロンプトに cmd+v で貼れます)"
fi

# --- 任意: studio 上の herdr エージェントに直接投げる ----------------------------
if [[ -n "$AGENT" ]]; then
  PROMPT="${MSG:-次のファイルを確認してください}"$'\n'"$PATHS"
  if herdr --machine "$HOST" agent prompt "$AGENT" "$PROMPT" >/dev/null; then
    log "(herdr: $HOST の $AGENT にプロンプトを送りました)"
  else
    log "(herdr --machine $HOST agent prompt が失敗しました。'herdr machine list' と 'herdr --machine $HOST agent list' で確認してください)"
    exit 2
  fi
fi
