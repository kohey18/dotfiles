#!/usr/bin/env bash
# studio-sync: MacBook と mac-studio の /Users/Shared/sync を Mutagen で双方向同期する。
# 両方の Mac に同じ絶対パスでフォルダがあるので、Finder から herdr のペインにドラッグしたパスを
# studio 上の Claude Code / Codex がそのまま Read できる。
#
#   studio-sync setup     初回: 両機にフォルダを作り、studio の CLAUDE.md / AGENTS.md に案内を追記し、
#                         mutagen daemon をログイン時自動起動にして同期セッションを作る (何度実行しても安全)
#   studio-sync status    同期状態 (mutagen sync list)
#   studio-sync pause | resume | flush | reset   (reset: 中身を全部消して "Halted" になったときの復帰にも使う)
#   studio-sync remove    セッションを消す (フォルダとファイルは残る)
#
# 環境変数: STUDIO_HOST (ssh Host, 既定 studio) / STUDIO_SYNC_DIR (既定 /Users/Shared/sync)
#           STUDIO_SYNC_MODE (既定 two-way-safe。片方向にするなら one-way-replica)
set -euo pipefail

HOST="${STUDIO_HOST:-studio}"
DIR="${STUDIO_SYNC_DIR:-/Users/Shared/sync}"
NAME="${STUDIO_SYNC_NAME:-studio}"
MODE="${STUDIO_SYNC_MODE:-two-way-safe}"

log() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
die() { printf 'studio-sync: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# studio 側のエージェント向け案内。マーカー行があれば追記しない
AGENT_NOTE_MARKER="## MacBook との同期フォルダ"
agent_note() {
  cat <<NOTE

${AGENT_NOTE_MARKER}
${DIR} は手元の端末 (MacBook など、この Mac に ssh してくる側) と Mutagen で双方向同期されている。
この Mac のホーム以外の /Users/<別ユーザ>/... で始まるパスや、この Mac に存在しないパスを渡されたら、
そのファイルは別の Mac にあるので「${DIR} に入れてください」と頼む。
成果物を手元の端末に渡したいときもここに書く。
NOTE
}

remote_setup() {
  log "studio: ${DIR} を作成し、CLAUDE.md / AGENTS.md に案内を追記"
  # 案内文はローカルで組み立てて base64 で渡す (リモート側の引用を気にしなくて済む)
  local note_b64
  note_b64="$(agent_note | base64)"
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" "
    set -e
    mkdir -p '${DIR}' ~/.claude ~/.codex
    note=\"\$(printf %s '${note_b64}' | base64 -d)\"
    for f in ~/.claude/CLAUDE.md ~/.codex/AGENTS.md; do
      if ! grep -qsF '${AGENT_NOTE_MARKER}' \"\$f\"; then
        printf '%s\\n' \"\$note\" >> \"\$f\"
      fi
    done
  " || die "$HOST に ssh できません (Tailscale 接続と ssh 鍵を確認)"
}

cmd_setup() {
  command -v mutagen >/dev/null 2>&1 || die "mutagen がありません: brew install mutagen-io/mutagen/mutagen"
  log "local: ${DIR} を作成"
  mkdir -p "$DIR"
  # フォルダが空になると Mutagen が安全弁 (one-sided root emptying) で停止するので、空にならない番人を置く
  touch "$DIR/.keep"
  remote_setup
  log "mutagen daemon をログイン時自動起動に登録"
  mutagen daemon register >/dev/null 2>&1 || true
  mutagen daemon start >/dev/null 2>&1 || true
  if mutagen sync list "$NAME" >/dev/null 2>&1; then
    log "ok      同期セッション '${NAME}' は作成済み"
  else
    log "同期セッション '${NAME}' を作成 (${MODE})"
    mutagen sync create --name "$NAME" --mode "$MODE" --ignore .DS_Store \
      "$DIR" "${HOST}:${DIR}"
  fi
  mutagen sync list "$NAME"
  log "Finder で ${DIR} を開きます。サイドバーの「よく使う項目」にドラッグしておくと Dropbox 感覚で使えます"
  open "$DIR" 2>/dev/null || true
}

case "${1:-}" in
  setup)  cmd_setup ;;
  status) mutagen sync list "$NAME" ;;
  pause|resume|flush|reset) mutagen sync "$1" "$NAME" ;;
  remove) mutagen sync terminate "$NAME" ;;
  -h|--help|help|"") usage 0 ;;
  *) usage 1 ;;
esac
